# Leave empty to use same-origin /api (recommended for Netlify + local Vite proxy).
# Only set this when the browser must call the backend URL directly (CORS required).
# Example: VITE_API_URL=https://api.example.com/api
VITE_API_URL=

# Local Vite proxy target: API origin only (no trailing /api).
# Browser calls /api/* on the Vite host; Vite forwards to this origin.
# Example: VITE_DEV_API_PROXY=http://localhost:8082
VITE_DEV_API_PROXY=

# Required on Netlify builds. API origin only (no trailing /api).
# The build writes dist/_redirects so /api/* proxies same-origin to this backend.
# Example: BACKEND_API_URL=https://api.example.com
BACKEND_API_URL=
